# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur vérifié dans Resend (domaine ou adresse vérifiée)
MAIL_FROM=reservations@votre-domaine.com
# Adresse qui reçoit les demandes du site
MAIL_TO=contact@votre-domaine.com

# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Port d'écoute (Render fournit PORT automatiquement)
PORT=4100
